{
  "name": "ldj-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync": "npm run build && cap sync",
    "sync:android": "npm run build && cap sync android",
    "sync:ios": "npm run build && cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "check": "node --check scripts/build.mjs && node --check scripts/check-inline.mjs && node --check src/native-bridge.js && node scripts/check-inline.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/geolocation": "8.2.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@tailwindcss/cli": "4.3.0",
    "esbuild": "0.28.2",
    "lottie-web": "5.12.2",
    "tailwindcss": "4.3.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
